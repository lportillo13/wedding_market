# Docker publishes the app to loopback only. Change this if port 3001 is occupied.
APP_PORT=3001

# Public values are embedded in the browser bundle during `docker compose build`.
NEXT_PUBLIC_SITE_URL=https://thewedmarket.com
NEXT_PUBLIC_APP_URL=https://thewedmarket.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_MAPS_JS_API_KEY
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://YOUR_PUBLIC_BUCKET_URL.r2.dev

# Server-only values. Never commit deploy/.env.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=the-wedding-market
R2_ENDPOINT=https://YOUR_R2_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://YOUR_PUBLIC_BUCKET_URL.r2.dev

# Optional integrations.
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
