{
  "name": "Wedding Market",
  "short_name": "Wedding Market",
  "description": "Find, shortlist, and request quotes from curated wedding vendors.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8f8f6",
  "theme_color": "#b8922a",
  "orientation": "portrait-primary",
  "categories": ["lifestyle", "shopping", "productivity"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Explore vendors",
      "short_name": "Vendors",
      "url": "/vendors",
      "description": "Browse wedding vendors by category."
    },
    {
      "name": "Request quotes",
      "short_name": "Quotes",
      "url": "/rfq/new",
      "description": "Send a quote request to selected vendors."
    }
  ]
}
