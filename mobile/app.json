{
  "expo": {
    "name": "The Wedding Market",
    "slug": "the-wedding-market",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon-512.png",
    "userInterfaceStyle": "light",
    "scheme": "theweddingmarket",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon-192.png",
          "color": "#1D7A72"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow The Wedding Market to access images you choose for profile and vendor media."
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon-512.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F8F6"
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theweddingmarket.app"
    },
    "android": {
      "package": "com.theweddingmarket.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-512.png",
        "backgroundColor": "#F8F8F6"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "appName": "The Wedding Market",
      "eas": {
        "projectId": "ed313d2c-f5d1-42b7-bf2f-eb71bb496b4e"
      }
    }
  }
}
