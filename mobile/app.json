{
  "expo": {
    "name": "The Wedding Market",
    "slug": "the-wedding-market",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "light",
    "scheme": "theweddingmarket",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification.png",
          "color": "#4B352C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow The Wedding Market to access images you choose for profile and vendor media.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F0"
        }
      ],
      ["expo-secure-store", {"faceIDPermission": false}]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theweddingmarket.app",
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "es"
        ],
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "allowBackup": false,
      "package": "com.theweddingmarket.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#4B352C"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "appName": "The Wedding Market",
      "eas": {
        "projectId": "ed313d2c-f5d1-42b7-bf2f-eb71bb496b4e"
      }
    }
  }
}
