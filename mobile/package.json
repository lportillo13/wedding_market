{
  "name": "the-wedding-market-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:expo-go": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android:dev": "npx --yes eas-cli build --platform android --profile development",
    "build:android:preview": "npx --yes eas-cli build --platform android --profile preview",
    "build:android:production": "npx --yes eas-cli build --platform android --profile production",
    "build:ios:dev": "npx --yes eas-cli build --platform ios --profile development",
    "build:ios:preview": "npx --yes eas-cli build --platform ios --profile preview",
    "build:ios:production": "npx --yes eas-cli build --platform ios --profile production",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "launch:audit": "node ../scripts/audit-mobile-launch.mjs",
    "expo:check": "expo install --check",
    "lint": "eslint App.tsx src --max-warnings=0",
    "test": "jest --runInBand --cacheDirectory .cache/jest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run expo:check"
  },
  "dependencies": {
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.106.1",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "shell-quote": "1.11.0",
    "xcode": {
      "uuid": "11.1.1"
    },
    "image-size": "2.0.4"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ]
  }
}
