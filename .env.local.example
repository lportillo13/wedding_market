# Public (safe to expose in browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_MAPS_JS_API_KEY

# Server-only (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Optional: server-side key used for Google Business reviews. Falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY if unset.
GOOGLE_PLACES_API_KEY=YOUR_PLACES_API_KEY
# If you use server-side webhook verification or RLS helpers requiring it:
# SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
